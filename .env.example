# Copy this file to .env.local (gitignored) and fill in real values from
# your Supabase project settings (Project Settings -> API).
# Apply supabase/migrations/0001_quiz_results.sql to that project first.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security entirely - required for the
# /analytics dashboard to read participant data (including email), which
# the anon key structurally cannot see. Never expose this to the client.
SUPABASE_SECRET_KEY=sb_secret_...

# Server-only. Shared passcode that gates /analytics. Also doubles as the
# signing secret for the analytics session cookie, so rotating this value
# immediately logs out every existing session.
ANALYTICS_PASSCODE=choose-a-long-random-passcode

# --- Instagram comment -> auto-DM webhook (/api/instagram/webhook) ---
# All server-only. See instagram-dm-automation.md for the Meta-side setup and
# specs/instagram-dm-webhook/spec.md for the contract.

# Long-lived access token for the Instagram-login app. Short-lived tokens
# expire in ~1h; exchange for a 60-day one and rotate it before it expires,
# or the automation silently stops sending.
IG_ACCESS_TOKEN=

# The `id` returned by /me - NOT the 17841... `user_id`, which belongs to the
# Facebook-login path and fails with error code 100 / subcode 33 here.
IG_ACCOUNT_ID=28392521167038682

# Shared secret echoed back during Meta's callback-URL verification handshake.
# Pick any random string; it must match what you enter in the Meta dashboard.
# Real value belongs in .env.local / Vercel, never in this committed file.
IG_VERIFY_TOKEN=

# Case-insensitive substring match against the comment text.
IG_TRIGGER_WORD=country

# The DM body sent to anyone who comments the trigger word.
IG_REPLY_TEXT=

# Instagram App Secret, from the Instagram product's API-setup page - this may
# differ from the secret under App Settings -> Basic. When set, every webhook
# POST must carry a valid X-Hub-Signature-256 or it is rejected with 403. When
# unset, signatures are not checked and a warning is logged: fine for bring-up,
# not for production.
IG_APP_SECRET=

# Testing escape hatch. Set to exactly "true" to let the account owner trigger
# the bot from their own comments. Leave unset in production so the bot never
# replies to itself.
IG_ALLOW_SELF_COMMENTS=
